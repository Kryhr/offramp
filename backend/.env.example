# ---- Cashra backend environment ----
# Copy to .env on the VPS and fill in real values. NEVER commit the real .env.

# Server
NODE_ENV=production
PORT=8080
# The exact origin of the public site (for CORS). No trailing slash.
FRONTEND_ORIGIN=https://your-domain.com

# PostgreSQL connection (use a least-privilege DB user, not the superuser)
DATABASE_URL=postgres://cashra_app:CHANGE_ME@localhost:5432/cashra

# Auth secrets  ---  generate with:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_64_hex_chars
ADMIN_JWT_SECRET=CHANGE_ME_DIFFERENT_64_hex_chars

# Field-encryption master key (32 bytes, base64).  generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Store this OUTSIDE the database. Losing it makes encrypted data unrecoverable.
DATA_ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes

# Access-token lifetime
TOKEN_TTL=2h
ADMIN_TOKEN_TTL=8h
